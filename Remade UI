					rowButton.Size = UDim2.new(1, -6, 0, 30)
					rowButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
					rowButton.TextColor3 = Color3.fromRGB(255, 255, 255)
					rowButton.TextSize = 14
					rowButton.Font = Enum.Font.SourceSansBold
					rowButton.Text = "  " .. model.Name .. " [" .. teamName .. "] [" .. tostring(hp) .. " HP]"
					rowButton.TextXAlignment = Enum.TextXAlignment.Left
					rowButton.Parent = teleportList

					local stroke = Instance.new("UIStroke")
					stroke.Color = Color3.fromRGB(255, 0, 4)
					stroke.Thickness = 1
					stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					stroke.Parent = rowButton

					rowButton.MouseButton1Click:Connect(function()
						local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
						if myHrp and hrp.Parent then
							myHrp.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)
						end
					end)
				end
			end
		end
	end
end

