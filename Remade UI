local function cleanupCOOLGUI()
	_G.CustomSpeed = 16
	_G.IsFlyActive = false
	_G.IsNoclipActive = false

	isFlying = false
	isSpeedCheatRunning = false
	isNoclipActive = false

	if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
	if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart")

		if humanoid then
			humanoid.WalkSpeed = 16
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero

			for _, object in ipairs(hrp:GetChildren()) do
				if object:IsA("BodyVelocity")
					or object:IsA("BodyGyro")
					or object:IsA("BodyPosition")
					or object:IsA("BodyAngularVelocity") then
					object:Destroy()
				end
			end
		end

		for _, part in ipairs(character:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end

	isEspActive = false
	if activeEspObjects then
		for model in pairs(activeEspObjects) do
			removeESP(model)
		end
	end

	isPanelOpen = false
	if teleportList then teleportList.Visible = false end
	if clearTeleportList then clearTeleportList() end

	isCarHackActive = false
	if carLoopConnection then
		carLoopConnection:Disconnect()
		carLoopConnection = nil
	end
	currentVictim = nil
end

btnDestroy.MouseButton1Click:Connect(function()
	cleanupCOOLGUI()
	screenGui:Destroy()
end)


