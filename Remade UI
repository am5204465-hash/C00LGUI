-- WALLHACK (ESP)
--========================================================
local isEspActive = false
local activeEspObjects = {}

local function removeESP(model)
	if activeEspObjects[model] then
		for _, object in pairs(activeEspObjects[model].instances) do
			if object then object:Destroy() end
		end
		activeEspObjects[model] = nil
	end
end

local function getTeamInfo(model)
	local charPlayer = Players:GetPlayerFromCharacter(model)
	if charPlayer and charPlayer.Team then
		return charPlayer.Team.Name, charPlayer.TeamColor.Color
	end
	return "No Team", Color3.fromRGB(255, 0, 0)
end

local function applyAdvancedESP(model)
	if player.Character and model == player.Character then return end
	if activeEspObjects[model] then return end

	local hrp = model:FindFirstChild("HumanoidRootPart") or model:WaitForChild("HumanoidRootPart", 5)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then return end

	local teamName, espColor = getTeamInfo(model)
	local instances = {}

	local highlight = Instance.new("Highlight")
	highlight.FillColor = espColor
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model
	table.insert(instances, highlight)

	local box = Instance.new("SelectionBox")
	box.Color3 = espColor
	box.LineThickness = 0.04
	box.Adornee = model
	box.Visible = true
	box.Parent = hrp
	table.insert(instances, box)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 300, 0, 50)
	billboard.AlwaysOnTop = true
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.Adornee = hrp
	billboard.Parent = hrp
	table.insert(instances, billboard)

	local espLabel = Instance.new("TextLabel")
	espLabel.Size = UDim2.new(1, 0, 1, 0)
	espLabel.BackgroundTransparency = 1
	espLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	espLabel.TextStrokeTransparency = 0
	espLabel.TextSize = 14
	espLabel.Font = Enum.Font.SourceSansBold
	espLabel.Text = model.Name
	espLabel.Parent = billboard

	local pathFolder = Instance.new("Folder")
	pathFolder.Name = "PathNodes"
	pathFolder.Parent = Workspace
	table.insert(instances, pathFolder)

	activeEspObjects[model] = {
		instances = instances,
		textLabel = espLabel,
		pathFolder = pathFolder,
		hrp = hrp,
		humanoid = humanoid,
		teamName = teamName
	}
end

local function createNeonSegment(p1, p2, folder)
	local distance = (p1 - p2).Magnitude
	if distance < 0.1 then return end
	local adornment = Instance.new("CylinderHandleAdornment")
	adornment.Radius = 0.12
	adornment.Height = distance
	adornment.Color3 = Color3.fromRGB(0, 255, 255)
	adornment.AlwaysOnTop = true
	adornment.Adornee = Workspace
	adornment.CFrame = CFrame.lookAt(p1, p2) * CFrame.new(0, 0, -distance / 2)
	adornment.Parent = folder
end

local function drawPath(data, myHrp)
	local folder = data.pathFolder
	local startPos = myHrp.Position - Vector3.new(0, 2.3, 0)
	local endPos = data.hrp.Position - Vector3.new(0, 2.3, 0)

	if _G.IsNoclipActive == true then
		folder:ClearAllChildren()
		createNeonSegment(startPos, endPos, folder)
		return
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {player.Character, data.hrp.Parent, folder}

	local rayResult = Workspace:Raycast(myHrp.Position, Vector3.new(0, -500, 0), raycastParams)
	local groundY = rayResult and rayResult.Position.Y or endPos.Y
	local myGroundPos = Vector3.new(myHrp.Position.X, groundY + 0.2, myHrp.Position.Z)

	if _G.IsFlyActive == true then
		local path = PathfindingService:CreatePath({AgentRadius = 2.0, AgentHeight = 5, AgentCanJump = true})
		local success = pcall(function() path:ComputeAsync(endPos, myGroundPos) end)
		if success and path.Status == Enum.PathStatus.Success then
			local waypoints = path:GetWaypoints()
			if #waypoints >= 2 then
				folder:ClearAllChildren()
				for i = 1, #waypoints - 1 do
					local p1 = waypoints[i].Position + Vector3.new(0, 0.2, 0)
					local p2 = waypoints[i + 1].Position + Vector3.new(0, 0.2, 0)
					createNeonSegment(p1, p2, folder)
				end
				local lastWpPos = waypoints[#waypoints].Position + Vector3.new(0, 0.2, 0)
				createNeonSegment(lastWpPos, startPos, folder)
				return
			end
		end
	else
		local path = PathfindingService:CreatePath({AgentRadius = 2.0, AgentHeight = 5, AgentCanJump = true})
		local success = pcall(function() path:ComputeAsync(endPos, startPos) end)
		if success and path.Status == Enum.PathStatus.Success then
			local waypoints = path:GetWaypoints()
			if #waypoints >= 2 then
				folder:ClearAllChildren()
				for i = 1, #waypoints - 1 do
					local p1 = waypoints[i].Position + Vector3.new(0, 0.2, 0)
					local p2 = waypoints[i + 1].Position + Vector3.new(0, 0.2, 0)
					createNeonSegment(p1, p2, folder)
				end
				return
			end
		end
	end
	folder:ClearAllChildren()
	createNeonSegment(startPos, endPos, folder)
end

RunService.Heartbeat:Connect(function()
	if not isEspActive then return end
	local myCharacter = player.Character
	local myHrp = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

	for model, data in pairs(activeEspObjects) do
		if not model.Parent or not data.hrp:IsDescendantOf(Workspace) then
			removeESP(model)
			continue
		end

		local hp = math.round(data.humanoid.Health)
		local distance = 0
		if myHrp then
			distance = math.round((myHrp.Position - data.hrp.Position).Magnitude)
			drawPath(data, myHrp)
		end

		data.textLabel.Text = model.Name .. " [" .. data.teamName .. "] [" .. tostring(hp) .. " HP] [" .. tostring(distance) .. " Studs]"
	end
end)

local function scanMap()
	for _, descendant in pairs(Workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") then
			local model = descendant.Parent
			if model and model:IsA("Model") then
				applyAdvancedESP(model)
			end
		end
	end
end

btnWallhack.MouseButton1Click:Connect(function()
	isEspActive = not isEspActive
	if isEspActive then
		btnWallhack.Text = "Wallhack"
		scanMap()
	else
		btnWallhack.Text = "Wallhack"
		for model in pairs(activeEspObjects) do
			removeESP(model)
		end
	end
end)

